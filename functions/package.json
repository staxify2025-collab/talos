{
  "name": "talos-functions",
  "version": "2.0.0",
  "description": "Talos SaaS — Cloud Functions (Gemini 3 Flash + Context Caching)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "lint": "eslint src/**/*.ts"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "cors": "^2.8.5",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
